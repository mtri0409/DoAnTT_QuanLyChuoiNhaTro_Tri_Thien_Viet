# Cấu hình FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000

# Cấu hình mặc định cho AI Provider (có thể override bằng payload từ Java)
DEFAULT_AI_PROVIDER=GEMINI
DEFAULT_AI_API_KEY=your_api_key_here
DEFAULT_AI_BASE_URL=https://generativelanguage.googleapis.com
DEFAULT_AI_MODEL=gemini-1.5-pro

# URL của Java Backend (để gọi ngược API)
JAVA_BACKEND_API_BASE=http://backend:8080/api/v1/internal/ai-tools